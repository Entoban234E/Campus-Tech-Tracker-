-- Clean existing tables if re-running
DROP TABLE IF EXISTS assets CASCADE;
DROP TABLE IF EXISTS users CASCADE;

-- 1. Users Table (Campus Community Members)
CREATE TABLE users (
    user_id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    department VARCHAR(100) NOT NULL,
    role VARCHAR(20) DEFAULT 'STUDENT' CHECK (role IN ('STUDENT', 'STAFF', 'ADMIN')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 2. Assets Table (Hardware Equipment)
CREATE TABLE assets (
    asset_id SERIAL PRIMARY KEY,
    asset_tag VARCHAR(50) UNIQUE NOT NULL, -- e.g., 'LAP-001'
    name VARCHAR(100) NOT NULL,          -- e.g., 'Dell XPS 15'
    category VARCHAR(50) NOT NULL,       -- e.g., 'Laptop', 'Projector'
    status VARCHAR(20) DEFAULT 'AVAILABLE' CHECK (status IN ('AVAILABLE', 'BORROWED', 'MAINTENANCE')),
    assigned_user_id INTEGER NULL REFERENCES users(user_id) ON DELETE SET NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Performance Indexing for Foreign Keys & Status Filters
CREATE INDEX idx_assets_status ON assets(status);
CREATE INDEX idx_assets_user ON assets(assigned_user_id);

